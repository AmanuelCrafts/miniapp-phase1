# ---------------------------------------------------------------------------
# Copy this file to `client/.env.local` and set the API origin.
# Only `NEXT_PUBLIC_*` values reach the browser bundle, and only public
# configuration may use that prefix. Never put the Telegram bot token or the
# session secret here - they belong in `server/.env`.
# ---------------------------------------------------------------------------

# Base URL of the Express API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000
