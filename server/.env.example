# ---------------------------------------------------------------------------
# Copy this file to `server/.env` and fill in real values.
# NEVER commit the real `.env` file. The bot token, session secret and
# database credentials must never reach the frontend or source control.
# ---------------------------------------------------------------------------

# Runtime mode: development | test | production
NODE_ENV=development

# Port the Express API listens on
PORT=4000

# MongoDB connection string (Atlas or local mongod)
MONGODB_URI=mongodb://127.0.0.1:27017/telegram_rewards

# Telegram bot token from @BotFather.
# SERVER-SIDE ONLY. Used to build the HMAC secret key that signs initData.
# NEVER prefix this with NEXT_PUBLIC_ and never send it to the browser.
# The server refuses to boot in production while a placeholder is still here.
TELEGRAM_BOT_TOKEN=1234567890:REPLACE-WITH-YOUR-REAL-BOT-TOKEN-FROM-BotFather

# Secret used to sign session cookies and derive session token hashes.
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE-WITH-A-LONG-RANDOM-STRING

# Session lifetime in days (default 30)
SESSION_TTL_DAYS=30

# Session cookie name (default tgma_session)
SESSION_COOKIE_NAME=tgma_session

# Cookie SameSite policy: lax | strict | none
# `none` is required in production when the API and the Mini App live on
# different sites (the usual case). Leave empty to auto-detect.
SESSION_COOKIE_SAME_SITE=none

# Comma separated allowlist of browser origins allowed to call this API.
# Example: https://app.example.com,https://web.telegram.org
FRONTEND_URL=http://localhost:3000

# Authentication rate limiting: max attempts per window, per client IP
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Reject Telegram initData whose auth_date is older than this (seconds).
# Telegram clients refresh initData on every launch; 24h is a safe default.
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Optional: extra Ed25519 public key (base64url, 32 bytes) used for third
# party validation of the optional `signature` field. When omitted, the key
# is derived from TELEGRAM_BOT_TOKEN automatically.
# TELEGRAM_ED25519_PUBLIC_KEY=

# Number of reverse proxy hops to trust when deriving client IPs (0 = none)
TRUST_PROXY_HOPS=1

# Log verbosity: debug | info | warn | error | silent
LOG_LEVEL=info
