# ── Database ────────────────────────────────────────────────────────────────
# MongoDB connection string (local or hosted, e.g. MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/birrly

# ── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather. SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=

# Maximum age (seconds) of Telegram initData auth_date before it is rejected.
# 600 (10 min) recommended: Telegram's Android webview caches initData
# (tdesktop#28303), so long windows can silently keep a stale account signed in.
TELEGRAM_AUTH_MAX_AGE=600

# ── Sessions ────────────────────────────────────────────────────────────────
# Random secret used to pepper session-token hashes (min 32 chars).
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Session lifetime in seconds (default: 7 days).
SESSION_MAX_AGE=604800

# ── Rate limiting ───────────────────────────────────────────────────────────
# Allowed POST /api/auth/telegram attempts per IP per minute.
AUTH_RATE_LIMIT=60
